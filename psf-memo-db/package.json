{
  "name": "psf-memo-db",
  "version": "1.0.0",
  "description": "LevelDB REST API for Memo protocol indexing.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run docs",
    "start": "node index.js",
    "test": "export SVC_ENV=test && c8 --reporter=text mocha --exit --timeout 15000 --recursive test/unit/",
    "lint": "standard --env mocha --fix",
    "docs": "./node_modules/.bin/apidoc -i src/ -o docs"
  },
  "author": "Chris Troutner",
  "license": "MIT",
  "apidoc": {
    "title": "psf-memo-db",
    "url": "localhost:5021"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "kcors": "2.2.2",
    "koa": "2.13.1",
    "koa-bodyparser": "4.3.0",
    "koa-convert": "2.0.0",
    "koa-logger": "3.2.1",
    "koa-mount": "4.0.0",
    "koa-router": "10.0.0",
    "koa-static": "5.0.0",
    "level": "7.0.1",
    "shelljs": "0.10.0",
    "winston": "3.3.3",
    "winston-daily-rotate-file": "4.5.0"
  },
  "devDependencies": {
    "apidoc": "0.51.1",
    "c8": "10.1.3",
    "chai": "4.3.0",
    "mocha": "10.0.0",
    "sinon": "9.2.4",
    "standard": "17.0.0"
  }
}
