# psf-memo-db REST API base URL (no trailing slash).
# Used at build time by Create React App (must be prefixed with REACT_APP_).
REACT_APP_MEMO_DB_URL=http://localhost:5021

# bch-file-hosting REST API base URL (no trailing slash), used by the /host
# and /dashboard pages. Defaults to https://file-hosting-api.blippost.com.
REACT_APP_FILE_HOSTING_URL=https://file-hosting-api.blippost.com
