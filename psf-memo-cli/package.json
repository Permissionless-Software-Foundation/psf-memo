    "dotenv": "17.2.3",
    "minimal-slp-wallet": "5.12.1",
    "shelljs": "0.8.5"
  },
  "devDependencies": {
    "c8": "10.1.2",
    "chai": "5.1.1",
    "crap4javascript": "github:FullStack-Agents/crap4javascript",
    "dry4javascript": "github:FullStack-Agents/dry4javascript",
    "mocha": "10.7.3",
    "mutate4javascript": "github:FullStack-Agents/mutate4javascript",
