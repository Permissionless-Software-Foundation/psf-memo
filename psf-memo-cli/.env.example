# Example environment variables for psf-memo-cli
# Copy this file to .env-local and modify the values as needed

# The REST URL for the server used by minimal-slp-wallet
# Default: https://free-bch.fullstack.cash
WALLET_URL=https://free-bch.fullstack.cash

# Interface type: 'consumer-api' (web 3 Cash Stack) or 'rest-api' (web 2 Cash Stack)
# Default: consumer-api
INTERFACE=consumer-api

# The read-only psf-memo-db REST API used by the memo-* commands.
# Default: https://memo-api.fullstackcash.net (production)
# Local development: http://localhost:5021
MEMO_DB_URL=https://memo-api.fullstackcash.net
